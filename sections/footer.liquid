<style>

  /* =====================================================
     PURELANE FOOTER
     ===================================================== */

  .purelane-footer {

    width: 100%;

    background:
      linear-gradient(
        135deg,
        #e5f5ec 0%,
        #d9f0e4 50%,
        #cfeadd 100%
      );

    color: #56576a;

    border-top: 1px solid rgba(66, 123, 94, .14);

  }


  .purelane-footer__container {

    width: min(1180px, calc(100% - 48px));

    margin: 0 auto;

    padding: 46px 0 28px;

  }


  /* =====================================================
     MAIN GRID
     ===================================================== */

  .purelane-footer__main {

    display: grid;

    grid-template-columns:
      minmax(280px, 1.6fr)
      minmax(150px, 1fr)
      minmax(150px, 1fr)
      minmax(210px, 1.1fr);

    column-gap: 50px;

    align-items: start;

  }


  /* =====================================================
     BRAND
     ===================================================== */

  .purelane-footer__brand-link {

    display: inline-flex;

    align-items: center;

    gap: 10px;

    color: inherit;

    text-decoration: none;

  }


  .purelane-footer__brand-icon {

    width: 40px;
    height: 40px;

    flex: 0 0 40px;

    display: grid;

    place-items: center;

    border-radius: 50%;

    background:
      rgba(255,255,255,.28);

    border: 1px solid rgba(178,138,82,.28);

  }


  .purelane-footer__brand-icon svg {

    width: 21px;
    height: 21px;

  }


  .purelane-footer__brand-text {

    display: flex;

    flex-direction: column;

    gap: 2px;

  }


  .purelane-footer__brand-name {

    color: #151d28;

    font-size: 17px;

    line-height: 1;

    font-weight: 800;

    letter-spacing: .015em;

  }


  .purelane-footer__brand-tagline {

    color: #89929a;

    font-size: 7px;

    line-height: 1;

    font-weight: 600;

    letter-spacing: .24em;

    text-transform: uppercase;

  }


  .purelane-footer__description {

    margin: 17px 0 0;

    color: #596876;

    font-size: 14px;

    line-height: 1.55;

    letter-spacing: .005em;

  }


  /* =====================================================
     COLUMNS
     ===================================================== */

  .purelane-footer__column h2 {

    margin: 3px 0 17px;

    color: #568b16;

    font-size: 11px;

    line-height: 1;

    font-weight: 800;

    letter-spacing: .19em;

    text-transform: uppercase;

  }


  .purelane-footer__column ul {

    margin: 0;

    padding: 0;

    list-style: none;

  }


  .purelane-footer__column li {

    margin: 0;

    padding: 0;

  }


  .purelane-footer__column a {

    position: relative;

    display: inline-block;

    padding: 5px 0;

    color: #596276;

    font-size: 14px;

    line-height: 1.35;

    text-decoration: none;

    transition:
      color .2s ease,
      transform .25s ease;

  }


  /* =====================================================
     HOVER ANIMATION
     WORD SLIDES SLIGHTLY RIGHT
     ===================================================== */

  .purelane-footer__column a:hover {

    color: #3f5f35;

    transform: translateX(5px);

  }


  .purelane-footer__column a::after {

    content: "";

    position: absolute;

    left: 0;
    bottom: 2px;

    width: 100%;
    height: 1px;

    background: #6c932d;

    transform: scaleX(0);

    transform-origin: left;

    transition: transform .25s ease;

  }


  .purelane-footer__column a:hover::after {

    transform: scaleX(1);

  }


  /* =====================================================
     CONTACT
     ===================================================== */

  .purelane-footer__contact a {

    padding: 5px 0;

  }


  .purelane-footer__company {

    padding-top: 5px;

    color: rgba(255,255,255,.30);

    font-size: 13px;

    line-height: 1.4;

  }


  /* =====================================================
     BOTTOM
     ===================================================== */

  .purelane-footer__bottom {

    margin-top: 38px;

    padding-top: 20px;

    border-top: 1px solid rgba(78, 130, 105, .18);

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

  }


  .purelane-footer__copyright {

    color: #7c858a;

    font-size: 12px;

    line-height: 1.4;

  }


  .purelane-footer__legal {

    display: flex;

    align-items: center;

    gap: 7px;

    color: #7c858a;

    font-size: 12px;

  }


  .purelane-footer__legal a {

    color: inherit;

    text-decoration: none;

    transition:
      color .2s ease,
      transform .25s ease;

  }


  .purelane-footer__legal a:hover {

    color: #4e6f36;

    transform: translateX(3px);

  }


  /* =====================================================
     TABLET
     ===================================================== */

  @media screen and (max-width: 900px) {

    .purelane-footer__main {

      grid-template-columns:
        1.5fr 1fr 1fr;

      row-gap: 38px;

    }


    .purelane-footer__brand {

      grid-column: 1 / -1;

    }

  }


  /* =====================================================
     MOBILE
     ===================================================== */

  @media screen and (max-width: 640px) {

    .purelane-footer__container {

      width: calc(100% - 40px);

      padding: 42px 0 24px;

    }


    .purelane-footer__main {

      display: flex;

      flex-direction: column;

      gap: 30px;

    }


    .purelane-footer__brand {

      width: 100%;

    }


    .purelane-footer__column {

      width: 100%;

    }


    .purelane-footer__column h2 {

      margin-bottom: 11px;

    }


    .purelane-footer__column a {

      padding: 6px 0;

    }


    .purelane-footer__bottom {

      margin-top: 34px;

      padding-top: 18px;

      flex-direction: column;

      align-items: flex-start;

      gap: 12px;

    }


    .purelane-footer__legal {

      flex-wrap: wrap;

    }

  }


  /* =====================================================
     REDUCED MOTION
     ===================================================== */

  @media (prefers-reduced-motion: reduce) {

    .purelane-footer__column a,
    .purelane-footer__column a::after,
    .purelane-footer__legal a {

      transition: none;

    }

  }

</style>


