<section class="purelane-coupon">

  <div class="purelane-coupon__card">

    <div class="purelane-coupon__content">

      <span class="purelane-coupon__eyebrow">
        {{ section.settings.eyebrow }}
      </span>

      <h2>
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.description != blank %}
        <p>
          {{ section.settings.description }}
        </p>
      {% endif %}


      <div class="purelane-coupon__action">

        <div class="purelane-coupon__code-wrap">

          <span class="purelane-coupon__code-label">
            YOUR CODE
          </span>

          <span
            class="purelane-coupon__code"
            id="PurelaneCouponCode-{{ section.id }}"
          >
            {{ section.settings.coupon_code }}
          </span>

        </div>


        <button
          type="button"
          class="purelane-coupon__button"
          data-coupon-code="{{ section.settings.coupon_code }}"
          aria-label="Copy coupon code"
        >
          COPY CODE
          <span aria-hidden="true">→</span>
        </button>

      </div>


      <span
        class="purelane-coupon__success"
        aria-live="polite"
      >
        Code copied!
      </span>

    </div>

  </div>

</section>


<style>

  /* =====================================================
     PURELANE COUPON
     ===================================================== */

  .purelane-coupon {

    width: 100%;

    padding: 38px 20px;

    background:
      linear-gradient(
        135deg,
        #dcefe6 0%,
        #cde6da 52%,
        #b9dbc9 100%
      );

  }


  .purelane-coupon__card {

    width: min(1080px, 100%);

    min-height: 245px;

    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: center;

    position: relative;

    overflow: hidden;

    border: 1px solid rgba(90, 112, 103, .16);

    border-radius: 28px;

    background:
      linear-gradient(
        135deg,
        rgba(255,255,255,.94),
        rgba(237,248,243,.90)
      );

    box-shadow:
      0 18px 45px rgba(54, 87, 72, .12);

  }


  .purelane-coupon__card::before {

    content: "";

    position: absolute;

    width: 360px;
    height: 360px;

    top: -230px;
    right: -100px;

    border-radius: 50%;

    background:
      rgba(126, 174, 145, .12);

  }


  .purelane-coupon__card::after {

    content: "";

    position: absolute;

    width: 300px;
    height: 300px;

    bottom: -220px;
    left: -80px;

    border-radius: 50%;

    background:
      rgba(112, 158, 133, .10);

  }


  .purelane-coupon__content {

    position: relative;

    z-index: 1;

    width: 100%;

    max-width: 820px;

    padding: 42px 30px;

    text-align: center;

  }


  /* =====================================================
     EYEBROW
     ===================================================== */

  .purelane-coupon__eyebrow {

    display: block;

    margin-bottom: 12px;

    color: #658d20;

    font-size: 10px;

    line-height: 1;

    font-weight: 800;

    letter-spacing: .22em;

    text-transform: uppercase;

  }


  /* =====================================================
     HEADING
     ===================================================== */

  .purelane-coupon h2 {

    margin: 0;

    color: #302b45;

    font-size: clamp(30px, 4vw, 52px);

    line-height: .98;

    font-weight: 800;

    letter-spacing: -.035em;

  }


  .purelane-coupon__content > p {

    margin: 14px 0 24px;

    color: #646477;

    font-size: 15px;

    line-height: 1.5;

  }


  /* =====================================================
     CODE + BUTTON
     ===================================================== */

  .purelane-coupon__action {

    display: flex;

    align-items: stretch;
    justify-content: center;

    gap: 10px;

  }


  .purelane-coupon__code-wrap {

    min-width: 190px;

    padding: 10px 17px;

    display: flex;

    flex-direction: column;

    align-items: flex-start;
    justify-content: center;

    text-align: left;

    border: 1px dashed rgba(80, 82, 104, .28);

    border-radius: 14px;

    background: rgba(255,255,255,.75);

  }


  .purelane-coupon__code-label {

    margin-bottom: 3px;

    color: #9494a0;

    font-size: 8px;

    line-height: 1;

    font-weight: 700;

    letter-spacing: .16em;

  }


  .purelane-coupon__code {

    color: #302b45;

    font-size: 17px;

    line-height: 1.1;

    font-weight: 800;

    letter-spacing: .12em;

  }


  .purelane-coupon__button {

    min-width: 165px;

    padding: 0 24px;

    border: 0;

    border-radius: 14px;

    background: #086f6b;

    color: #fff;

    cursor: pointer;

    font-family: inherit;

    font-size: 11px;

    line-height: 1;

    font-weight: 800;

    letter-spacing: .13em;

    transition:
      transform .22s ease,
      background-color .22s ease,
      box-shadow .22s ease;

  }


  .purelane-coupon__button span {

    margin-left: 7px;

  }


  .purelane-coupon__button:hover {

    background: #075c59;

    transform: translateY(-2px);

    box-shadow:
      0 9px 20px rgba(8, 111, 107, .20);

  }


  .purelane-coupon__button:active {

    transform: translateY(0);

  }


  /* =====================================================
     SUCCESS MESSAGE
     ===================================================== */

  .purelane-coupon__success {

    display: block;

    height: 0;

    margin-top: 0;

    overflow: hidden;

    color: #5e891d;

    font-size: 11px;

    font-weight: 700;

    opacity: 0;

    transition:
      opacity .2s ease,
      height .2s ease,
      margin-top .2s ease;

  }


  .purelane-coupon__success.is-visible {

    height: 16px;

    margin-top: 10px;

    opacity: 1;

  }


  /* =====================================================
     MOBILE
     ===================================================== */

  @media screen and (max-width: 640px) {

    .purelane-coupon {

      padding: 22px 12px;

    }


    .purelane-coupon__card {

      min-height: auto;

      border-radius: 22px;

    }


    .purelane-coupon__content {

      padding: 34px 20px;

    }


    .purelane-coupon h2 {

      font-size: 31px;

    }


    .purelane-coupon__content > p {

      font-size: 13px;

    }


    .purelane-coupon__action {

      flex-direction: column;

      gap: 9px;

    }


    .purelane-coupon__code-wrap {

      width: 100%;

      min-height: 58px;

      align-items: center;

      text-align: center;

    }


    .purelane-coupon__button {

      width: 100%;

      min-height: 52px;

    }

  }


  /* =====================================================
     REDUCED MOTION
     ===================================================== */

  @media (prefers-reduced-motion: reduce) {

    .purelane-coupon__button,
    .purelane-coupon__success {

      transition: none;

    }

  }

</style>


<script>

  document.addEventListener('DOMContentLoaded', () => {

    const couponSection =
      document.querySelector(
        '.purelane-coupon'
      );

    if (!couponSection) return;


    const button =
      couponSection.querySelector(
        '.purelane-coupon__button'
      );

    const success =
      couponSection.querySelector(
        '.purelane-coupon__success'
      );


    if (!button) return;


    button.addEventListener('click', async () => {

      const code =
        button.dataset.couponCode;

      if (!code) return;


      try {

        await navigator.clipboard.writeText(code);

      } catch (error) {

        const textarea =
          document.createElement('textarea');

        textarea.value = code;

        document.body.appendChild(textarea);

        textarea.select();

        document.execCommand('copy');

        textarea.remove();

      }


      const originalText =
        button.innerHTML;


      button.innerHTML =
        'COPIED ✓';


      success.classList.add(
        'is-visible'
      );


      setTimeout(() => {

        button.innerHTML =
          originalText;

        success.classList.remove(
          'is-visible'
        );

      }, 2200);

    });

  });

</script>


{% schema %}

{
  "name": "Purelane Coupon",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "JOIN THE PURELANE CLUB"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GET ₹100 OFF YOUR FIRST BUNDLE"
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Your first bundle deserves a little something extra."
    },

    {
      "type": "text",
      "id": "coupon_code",
      "label": "Coupon code",
      "default": "PURE100"
    }

  ],

  "presets": [
    {
      "name": "Purelane Coupon"
    }
  ]

}

{% endschema %}