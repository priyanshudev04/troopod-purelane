{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section
  class="purelane-combos"
  id="combos"
  style="
    --combos-bg: {{ section.settings.background_color }};
    --combos-text: {{ section.settings.text_color }};
    --combos-accent: {{ section.settings.accent_color }};
  "
>
  <div class="purelane-combos__container">

    <div class="purelane-combos__header">

      {% if section.settings.eyebrow != blank %}
        <span class="purelane-combos__eyebrow">
          {{ section.settings.eyebrow }}
        </span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="purelane-combos__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      <div class="purelane-combos__rule" aria-hidden="true">
        <span></span>
        <span class="purelane-combos__leaf">✦</span>
        <span></span>
      </div>

      {% if section.settings.description != blank %}
        <p class="purelane-combos__description">
          {{ section.settings.description }}
        </p>
      {% endif %}

    </div>


    <div
      class="purelane-combos__rail"
      role="region"
      aria-label="Best selling combos"
    >

      {% for block in section.blocks %}

        {% assign product_count = 0 %}

        {% if block.settings.product_1 != blank %}
          {% assign product_count = product_count | plus: 1 %}
        {% endif %}

        {% if block.settings.product_2 != blank %}
          {% assign product_count = product_count | plus: 1 %}
        {% endif %}

        {% if block.settings.product_3 != blank %}
          {% assign product_count = product_count | plus: 1 %}
        {% endif %}


        {% assign savings = block.settings.compare_price
          | minus: block.settings.bundle_price
        %}


        <article
          class="
            purelane-combo-card
            {% if block.settings.highlight %}
              purelane-combo-card--highlight
            {% endif %}
          "
          {{ block.shopify_attributes }}
        >

          <!-- =========================
               PRODUCT PREVIEW
          ========================== -->

          <div class="purelane-combo-card__tray">

            {% if block.settings.saving_label != blank %}
              <span class="purelane-combo-card__saving">
                {{ block.settings.saving_label }}
              </span>
            {% endif %}


            {% if block.settings.badge != blank %}
              <span class="purelane-combo-card__badge">
                {{ block.settings.badge }}
              </span>
            {% endif %}


            <div class="purelane-combo-card__products">

              {% if block.settings.product_1 != blank %}

                <div class="purelane-combo-card__product">

                  {% if block.settings.product_1.featured_image %}
                    {{
                      block.settings.product_1.featured_image
                      | image_url: width: 300
                      | image_tag:
                        loading: 'lazy',
                        widths: '120,180,240,300',
                        sizes: '90px',
                        alt: block.settings.product_1.title
                    }}
                  {% else %}
                    <div class="purelane-combo-card__placeholder">
                      <span>No image</span>
                    </div>
                  {% endif %}

                  {% if block.settings.product_1_label != blank %}
                    <span>
                      {{ block.settings.product_1_label }}
                    </span>
                  {% endif %}

                </div>

              {% endif %}


              {% if block.settings.product_1 != blank
                and block.settings.product_2 != blank
              %}
                <span
                  class="purelane-combo-card__plus"
                  aria-hidden="true"
                >
                  +
                </span>
              {% endif %}


              {% if block.settings.product_2 != blank %}

                <div class="purelane-combo-card__product">

                  {% if block.settings.product_2.featured_image %}
                    {{
                      block.settings.product_2.featured_image
                      | image_url: width: 300
                      | image_tag:
                        loading: 'lazy',
                        widths: '120,180,240,300',
                        sizes: '90px',
                        alt: block.settings.product_2.title
                    }}
                  {% else %}
                    <div class="purelane-combo-card__placeholder">
                      <span>No image</span>
                    </div>
                  {% endif %}

                  {% if block.settings.product_2_label != blank %}
                    <span>
                      {{ block.settings.product_2_label }}
                    </span>
                  {% endif %}

                </div>

              {% endif %}


              {% if block.settings.product_2 != blank
                and block.settings.product_3 != blank
              %}
                <span
                  class="purelane-combo-card__plus"
                  aria-hidden="true"
                >
                  +
                </span>
              {% endif %}


              {% if block.settings.product_3 != blank %}

                <div class="purelane-combo-card__product">

                  {% if block.settings.product_3.featured_image %}
                    {{
                      block.settings.product_3.featured_image
                      | image_url: width: 300
                      | image_tag:
                        loading: 'lazy',
                        widths: '120,180,240,300',
                        sizes: '90px',
                        alt: block.settings.product_3.title
                    }}
                  {% else %}
                    <div class="purelane-combo-card__placeholder">
                      <span>No image</span>
                    </div>
                  {% endif %}

                  {% if block.settings.product_3_label != blank %}
                    <span>
                      {{ block.settings.product_3_label }}
                    </span>
                  {% endif %}

                </div>

              {% endif %}

            </div>

          </div>


          <!-- =========================
               COMBO INFORMATION
          ========================== -->

          <div class="purelane-combo-card__body">

            {% if block.settings.title != blank %}
              <h3>
                {{ block.settings.title }}
              </h3>
            {% endif %}


            {% if block.settings.count_label != blank %}
              <div class="purelane-combo-card__count">
                {{ block.settings.count_label }}
              </div>
            {% elsif product_count > 0 %}
              <div class="purelane-combo-card__count">
                {{ product_count }} products
              </div>
            {% endif %}


            {% if block.settings.description != blank %}
              <p class="purelane-combo-card__description">
                {{ block.settings.description }}
              </p>
            {% endif %}


            <div class="purelane-combo-card__price">

              <strong>
                {{ block.settings.bundle_price | times: 100 | money }}
              </strong>

              {% if block.settings.compare_price > block.settings.bundle_price %}
                <s>
                  {{ block.settings.compare_price | times: 100 | money }}
                </s>
              {% endif %}

              {% if savings > 0 %}
                <em>
                  Save {{ savings | times: 100 | money }}
                </em>
              {% endif %}

            </div>


            {% if block.settings.fine_print != blank %}
              <div class="purelane-combo-card__fine">
                {{ block.settings.fine_print }}
              </div>
            {% endif %}


            {% if block.settings.button_label != blank %}

              <a
                href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
                class="
                  purelane-combo-card__button
                  {% if block.settings.highlight %}
                    purelane-combo-card__button--primary
                  {% endif %}
                "
              >
                {{ block.settings.button_label }}
                <span aria-hidden="true">→</span>
              </a>

            {% endif %}

          </div>

        </article>

      {% endfor %}

    </div>


    {% if section.settings.show_swipe_hint %}

      <div class="purelane-combos__swipe-hint">
        <span aria-hidden="true">→</span>
        Swipe for more combos
      </div>

    {% endif %}


    {% if section.settings.bottom_note != blank %}

      <p class="purelane-combos__note">
        {{ section.settings.bottom_note }}
      </p>

    {% endif %}

  </div>
</section>
<script>
  (() => {
    const rail = document.querySelector('.purelane-combos__rail');

    if (!rail || rail.dataset.dragReady === 'true') return;

    rail.dataset.dragReady = 'true';

    let isDragging = false;
    let startX = 0;
    let startScrollLeft = 0;

    rail.addEventListener('pointerdown', (event) => {
      // Only add mouse dragging.
      // Touch devices keep their native swipe behaviour.
      if (event.pointerType !== 'mouse') return;

      isDragging = true;
      startX = event.clientX;
      startScrollLeft = rail.scrollLeft;

      rail.classList.add('is-dragging');
    });

    rail.addEventListener('pointermove', (event) => {
      if (!isDragging) return;

      const distance = event.clientX - startX;

      rail.scrollLeft = startScrollLeft - distance;
    });

    const stopDragging = () => {
      if (!isDragging) return;

      isDragging = false;
      rail.classList.remove('is-dragging');
    };

    rail.addEventListener('pointerup', stopDragging);
    rail.addEventListener('pointercancel', stopDragging);
    rail.addEventListener('pointerleave', stopDragging);
  })();
</script>


