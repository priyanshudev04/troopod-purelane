<style>
  header-drawer {
    justify-self: start;
    margin-left: 0;
  }

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
  }

  .list-menu__item--link {
    text-decoration: none;
  }

  shopify-account.header__icon:not(:defined) {
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

{%- style -%}

  .section-header {
    position: sticky;
    top: 0;
    z-index: 50;

    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  .purelane-header-wrapper {
    width: 100%;
    background: transparent;
  }

  .purelane-header {
    width: min(1180px, calc(100% - 48px));
    min-height: 62px;

    margin: 10px auto 12px;
    padding: 7px 14px 7px 10px;

    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;

    background:
      linear-gradient(
        105deg,
        rgba(255,255,255,.96),
        rgba(245,245,252,.93)
      );

    border: 1px solid rgba(105, 87, 139, .18);
    border-radius: 999px;

    box-shadow:
      0 8px 28px rgba(50, 35, 80, .08);

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  /* =====================================================
     BRAND
     ===================================================== */

  .purelane-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    min-width: max-content;

    color: inherit;
    text-decoration: none;
  }

  .purelane-header__brand-icon {
    width: 42px;
    height: 42px;

    flex: 0 0 42px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background:
      radial-gradient(
        circle at 35% 30%,
        #ffffff 0,
        #f7f0e9 55%,
        #eee8e2 100%
      );

    border: 1px solid rgba(224, 169, 103, .22);
  }

  .purelane-header__brand-icon svg {
    width: 21px;
    height: 21px;
  }

  .purelane-header__brand-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .purelane-header__brand-name {
    color: #5e596a;

    font-size: 17px;
    line-height: 1;

    font-weight: 700;
    letter-spacing: .02em;
  }

  .purelane-header__brand-tagline {
    color: #aaa5b0;

    font-size: 7px;
    line-height: 1;

    font-weight: 600;
    letter-spacing: .23em;
    text-transform: uppercase;
  }

  /* =====================================================
     DESKTOP NAV
     ===================================================== */

  .purelane-header__nav {
    justify-self: center;
  }

  .purelane-header__nav-list {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 2px;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .purelane-header__nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 9px 13px;

    color: #554d67;

    font-size: 13px;
    line-height: 1;
    font-weight: 500;

    text-decoration: none;

    border-radius: 999px;

    transition:
      color .2s ease,
      background-color .2s ease;
  }

  .purelane-header__nav-link:hover,
  .purelane-header__nav-link[aria-current="page"] {
    color: #332a47;
    background: rgba(255,255,255,.65);
  }

  /* =====================================================
     ACTIONS
     ===================================================== */

  .purelane-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 2px;
  }

  .purelane-header__actions .header__icon {
    width: 38px;
    height: 38px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    color: #514960;

    transition:
      background-color .2s ease,
      transform .2s ease;
  }

  .purelane-header__actions .header__icon:hover {
    background: rgba(255,255,255,.7);
    transform: translateY(-1px);
  }

  .purelane-header__actions .svg-wrapper {
    width: 19px;
    height: 19px;
  }

  .purelane-header__cart {
    position: relative;
  }

  .purelane-header__cart .cart-count-bubble {
    top: 0;
    right: 0;

    min-width: 16px;
    min-height: 16px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #59448f;
    color: #fff;

    border-radius: 50%;

    font-size: 9px;
    line-height: 16px;
  }

  /* =====================================================
     MOBILE
     ===================================================== */

  .purelane-header__mobile-menu {
    display: none;
  }

  @media screen and (max-width: 989px) {

    .purelane-header {
      width: calc(100% - 20px);

      min-height: 58px;

      margin: 6px auto 8px;
      padding: 6px 8px;

      grid-template-columns: auto 1fr auto;
      gap: 6px;

      border-radius: 18px;
    }

    .purelane-header__mobile-menu {
      display: flex;
      align-items: center;
    }

    .purelane-header__mobile-menu header-drawer {
      display: block;
    }

    .purelane-header__mobile-menu .header__icon {
      width: 40px;
      height: 40px;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;
    }

    .purelane-header__brand {
      justify-self: center;
    }

    .purelane-header__brand-icon {
      width: 36px;
      height: 36px;
      flex-basis: 36px;
    }

    .purelane-header__brand-icon svg {
      width: 18px;
      height: 18px;
    }

    .purelane-header__brand-name {
      font-size: 15px;
    }

    .purelane-header__brand-tagline {
      font-size: 6px;
    }

    .purelane-header__nav {
      display: none;
    }

    .purelane-header__actions {
      gap: 0;
    }

    .purelane-header__actions .header__icon {
      width: 38px;
      height: 38px;
    }

    .purelane-header__actions .header__icon--account {
      display: none;
    }

    .purelane-header__actions .header__search {
      display: none;
    }

  }

  @media screen and (max-width: 380px) {

    .purelane-header {
      width: calc(100% - 12px);
      padding-left: 5px;
      padding-right: 5px;
    }

    .purelane-header__brand-name {
      font-size: 14px;
    }

  }

{%- endstyle -%}


{%- liquid

  assign header_tag = 'div'

  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif

-%}


<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="section-header"
>

  <div class="purelane-header-wrapper">

    <header class="purelane-header">

      <!-- =================================================
           MOBILE MENU
      ================================================== -->

      <div class="purelane-header__mobile-menu">

        {%- if section.settings.menu != blank -%}

          <header-drawer data-breakpoint="tablet">

            <details id="Details-menu-drawer-container">

              <summary
                class="header__icon header__icon--menu header__icon--summary link focus-inset"
                aria-label="{{ 'sections.header.menu' | t }}"
              >

                <span>
                  {{- 'icon-hamburger.svg' | inline_asset_content -}}
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>

              </summary>

              <div id="menu-drawer" class="gradient menu-drawer motion-reduce">

                <div class="menu-drawer__inner-container">

                  <div class="menu-drawer__navigation-container">

                    <nav class="menu-drawer__navigation">

                      <ul class="menu-drawer__menu has-submenu list-menu" role="list">

                        {% for link in section.settings.menu.links %}

                          <li>

                            <a
                              href="{{ link.url }}"
                              class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
                            >
                              {{ link.title }}
                            </a>

                          </li>

                        {% endfor %}

                      </ul>

                    </nav>

                  </div>

                </div>

              </div>

            </details>

          </header-drawer>

        {%- endif -%}

      </div>


      <!-- =================================================
           BRAND
      ================================================== -->

      <a
        href="{{ routes.root_url }}"
        class="purelane-header__brand"
        aria-label="Purelane home"
      >

        <span class="purelane-header__brand-icon">

          <svg
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >

            <path
              d="M12 3.5L19 7.5V16.5L12 20.5L5 16.5V7.5L12 3.5Z"
              stroke="#DDA56A"
              stroke-width="1.35"
              stroke-linejoin="round"
            />

            <path
              d="M5.4 7.7L12 11.5L18.6 7.7"
              stroke="#DDA56A"
              stroke-width="1.35"
              stroke-linejoin="round"
            />

            <path
              d="M12 11.5V20"
              stroke="#DDA56A"
              stroke-width="1.35"
            />

          </svg>

        </span>

        <span class="purelane-header__brand-text">

          <span class="purelane-header__brand-name">
            PURELANE
          </span>

          <span class="purelane-header__brand-tagline">
            CLEAN, SIMPLY
          </span>

        </span>

      </a>


      <!-- =================================================
           DESKTOP NAVIGATION
      ================================================== -->

      <nav
        class="purelane-header__nav"
        aria-label="Main navigation"
      >

        <ul class="purelane-header__nav-list">

          <li>
            <a
              href="{{ routes.root_url }}"
              class="purelane-header__nav-link"
            >
              Home
            </a>
          </li>

          <li>
            <a
              href="#ingredients"
              class="purelane-header__nav-link"
            >
              Ingredients
            </a>
          </li>

          <li>
            <a
              href="#how-it-works"
              class="purelane-header__nav-link"
            >
              How it works
            </a>
          </li>

          <li>
            <a
              href="{{ routes.root_url }}#shop"
              class="purelane-header__nav-link"
            >
              Shop
            </a>
          </li>

          <li>
            <a
              href="#bundles"
              class="purelane-header__nav-link"
            >
              Bundles
            </a>
          </li>

        </ul>

      </nav>


      <!-- =================================================
           ACTIONS
      ================================================== -->

      <div class="purelane-header__actions">

        <!-- Search -->

        <div class="purelane-header__search">

          {% render 'header-search', input_id: 'Search-In-Modal-Purelane' %}

        </div>


        <!-- Account -->

        {%- if shop.customer_accounts_enabled -%}

          <shopify-account
            menu="{{ settings.customer_account_menu | default: 'customer-account-main-menu' }}"
            class="header__icon header__icon--account link focus-inset"
          >

            <span slot="signed-out-avatar" class="svg-wrapper">
              {{ 'icon-account.svg' | inline_asset_content }}
            </span>

            <span
              slot="signed-out-avatar"
              class="visually-hidden"
            >
              {{ 'customer.log_in' | t }}
            </span>

          </shopify-account>

        {%- endif -%}


        <!-- Cart -->

        <a
          href="{{ routes.cart_url }}"
          class="header__icon header__icon--cart purelane-header__cart link focus-inset"
          id="cart-icon-bubble"
        >

          {% if cart == empty %}

            <span class="svg-wrapper">
              {{ 'icon-cart-empty.svg' | inline_asset_content }}
            </span>

          {% else %}

            <span class="svg-wrapper">
              {{ 'icon-cart.svg' | inline_asset_content }}
            </span>

          {% endif %}

          <span class="visually-hidden">
            {{ 'templates.cart.cart' | t }}
          </span>

          {%- if cart != empty -%}

            <div class="cart-count-bubble">

              {%- if cart.item_count < 100 -%}
                <span aria-hidden="true">
                  {{ cart.item_count }}
                </span>
              {%- endif -%}

              <span class="visually-hidden">
                {{ 'sections.header.cart_count' | t: count: cart.item_count }}
              </span>

            </div>

          {%- endif -%}

        </a>

      </div>

    </header>

  </div>

</{{ header_tag }}>


{% javascript %}

  class StickyHeader extends HTMLElement {

    constructor() {
      super();

      this.setHeaderHeight =
        this.setHeaderHeight.bind(this);
    }

    connectedCallback() {

      this.header =
        document.querySelector('.section-header');

      this.mobileMediaQuery =
        window.matchMedia('(max-width: 990px)');

      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';

      this.headerBounds = {};

      this.setHeaderHeight();

      this.mobileMediaQuery.addEventListener(
        'change',
        this.setHeaderHeight
      );

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add(
          'shopify-section-header-sticky'
        );
      }

      this.currentScrollTop = 0;

      this.preventReveal = false;

      this.onScrollHandler =
        this.onScroll.bind(this);

      window.addEventListener(
        'scroll',
        this.onScrollHandler,
        false
      );

      this.createObserver();
    }

    setHeaderHeight() {

      if (!this.header) return;

      document.documentElement.style.setProperty(
        '--header-height',
        `${this.header.offsetHeight}px`
      );
    }

    disconnectedCallback() {

      this.mobileMediaQuery.removeEventListener(
        'change',
        this.setHeaderHeight
      );

      window.removeEventListener(
        'scroll',
        this.onScrollHandler
      );
    }

    createObserver() {

      if (!this.header) return;

      let observer =
        new IntersectionObserver(
          (entries, observer) => {

            this.headerBounds =
              entries[0].intersectionRect;

            observer.disconnect();

          }
        );

      observer.observe(this.header);
    }

    onScroll() {

      const scrollTop =
        window.pageYOffset ||
        document.documentElement.scrollTop;

      if (
        scrollTop >
          this.currentScrollTop &&
        scrollTop >
          this.headerBounds.bottom
      ) {

        this.header.classList.add(
          'scrolled-past-header'
        );

      } else if (
        scrollTop <
          this.currentScrollTop &&
        scrollTop >
          this.headerBounds.bottom
      ) {

        this.header.classList.add(
          'scrolled-past-header'
        );

      } else if (
        scrollTop <=
        this.headerBounds.top
      ) {

        this.header.classList.remove(
          'scrolled-past-header'
        );

      }

      this.currentScrollTop =
        scrollTop;
    }

  }

  customElements.define(
    'sticky-header',
    StickyHeader
  );


  /* =========================================================
     PURELANE — SMOOTH ANCHOR NAVIGATION
     Shop points to the homepage Shop All section instead of
     opening Shopify's /collections/all route.
     ========================================================= */
  (() => {
    const header = document.querySelector('.section-header');
    const headerOffset = () => (header ? header.getBoundingClientRect().height + 18 : 92);

    const getShopTarget = () => document.querySelector('.purelane-shop');

    const smoothTo = (target) => {
      if (!target) return false;
      const top = target.getBoundingClientRect().top + window.scrollY - headerOffset();
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      return true;
    };

    document.addEventListener('click', (event) => {
      const link = event.target.closest('a[href]');
      if (!link) return;

      const href = link.getAttribute('href') || '';
      if (!href.endsWith('#shop')) return;

      const sameOrigin = link.origin === window.location.origin;
      const isHome = sameOrigin && link.pathname === window.location.pathname;
      const target = getShopTarget();

      if (target && isHome) {
        event.preventDefault();
        history.pushState(null, '', '#shop');
        smoothTo(target);
      }
    }, { passive: false });

    window.addEventListener('load', () => {
      if (window.location.hash === '#shop') {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => smoothTo(getShopTarget()));
        });
      }
    });
  })();

{% endjavascript %}


{% schema %}

{
  "name": "Purelane Header",

  "class": "section-header",

  "settings": [

    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Mobile menu"
    },

    {
      "type": "select",
      "id": "sticky_header_type",

      "options": [
        {
          "value": "none",
          "label": "Not sticky"
        },
        {
          "value": "on-scroll-up",
          "label": "Show on scroll up"
        },
        {
          "value": "always",
          "label": "Always sticky"
        }
      ],

      "default": "on-scroll-up",

      "label": "Sticky header"
    },

    {
      "type": "range",
      "id": "margin_bottom",

      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",

      "label": "Bottom spacing",

      "default": 0
    }

  ],

  "blocks": [
    {
      "type": "@app"
    }
  ]

}

{% endschema %}