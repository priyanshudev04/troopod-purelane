{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section class="purelane-hero-v2" id="purelane-hero">

  <div class="purelane-hero-v2__waves" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <div class="purelane-hero-v2__container">

    <div class="purelane-hero-v2__content">

      <h1 class="purelane-hero-v2__title">
        <span>CLEAN</span>
        <span>THAT</span>
        <span class="accent">LASTS</span>
      </h1>

      <div class="purelane-hero-v2__rule">
        <span></span>
        <svg viewBox="0 0 24 24" fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <span></span>
      </div>

      <p class="purelane-hero-v2__description">
        Homecare that works on the toughest grime, made from plants.
        Kind to your home, your family and the world outside it.
      </p>

      <div class="purelane-hero-v2__actions">
        <a href="#shop"
           class="purelane-hero-v2__button purelane-hero-v2__button--primary">
          SHOP NOW
          <span aria-hidden="true">→</span>
        </a>

        <a href="#how"
           class="purelane-hero-v2__button purelane-hero-v2__button--secondary">
          HOW IT WORKS
        </a>
      </div>

    </div>

    <div class="purelane-hero-v2__product-area" id="heroProductArea">

      <div class="purelane-hero-v2__product-glow" aria-hidden="true"></div>

      <div class="purelane-hero-v2__stage" id="purelaneHeroStage">

        <!-- 1 PRODUCT -->
        <div class="purelane-hero-v2__slide is-active" data-slide="0">

          <span
            class="purelane-hero-v2__bottle bottle-a bottle-kitchen"
            role="img"
            aria-label="Purelane foaming kitchen cleaner">
          </span>

          <div class="purelane-hero-v2__offer">
            <span class="offer-label">Single bottle</span>
            <div class="offer-price">
              <strong>₹200</strong>
              <s>₹299</s>
            </div>
            <span class="offer-save">33% OFF</span>
          </div>

        </div>

        <!-- 2 PRODUCTS -->
        <div class="purelane-hero-v2__slide" data-slide="1">

          <span
            class="purelane-hero-v2__bottle bottle-a bottle-tap"
            role="img"
            aria-label="Purelane tap cleaner">
          </span>

          <span
            class="purelane-hero-v2__bottle bottle-b bottle-kitchen"
            role="img"
            aria-label="Purelane foaming kitchen cleaner">
          </span>

          <div class="purelane-hero-v2__offer">
            <span class="offer-label">Any 2 products</span>
            <div class="offer-price">
              <strong>₹349</strong>
              <s>₹598</s>
            </div>
            <span class="offer-save">SAVE ₹249</span>
          </div>

        </div>

        <!-- 3 PRODUCTS -->
        <div class="purelane-hero-v2__slide" data-slide="2">

          <span
            class="purelane-hero-v2__bottle bottle-a bottle-tap"
            role="img"
            aria-label="Purelane tap cleaner">
          </span>

          <span
            class="purelane-hero-v2__bottle bottle-b bottle-metal"
            role="img"
            aria-label="Purelane copper, bronze and brass cleaner">
          </span>

          <span
            class="purelane-hero-v2__bottle bottle-c bottle-kitchen"
            role="img"
            aria-label="Purelane foaming kitchen cleaner">
          </span>

          <div class="purelane-hero-v2__offer">
            <span class="offer-label">Any 3 products</span>
            <div class="offer-price">
              <strong>₹499</strong>
              <s>₹897</s>
            </div>
            <span class="offer-save">SAVE ₹398</span>
          </div>

        </div>

      </div>

      <div class="purelane-hero-v2__trust-card">

        <div class="trust-item">
          <div class="trust-icon">🌿</div>
          <div>
            <strong>PLANT</strong>
            <span>POWERED</span>
          </div>
        </div>

        <div class="trust-divider"></div>

        <div class="trust-item">
          <div class="trust-icon">✓</div>
          <div>
            <strong>SAFE FOR</strong>
            <span>KIDS &amp; PETS</span>
          </div>
        </div>

        <div class="trust-divider"></div>

        <div class="trust-item">
          <div class="trust-icon">◯</div>
          <div>
            <strong>ZERO HARSH</strong>
            <span>CHEMICALS</span>
          </div>
        </div>

      </div>

    </div>

  </div>

  <!-- 1 / 2 / 3 selector -->
  <div class="purelane-hero-v2__dots" id="purelaneHeroDots" aria-label="Hero product offers">

    <button
      class="is-active"
      type="button"
      data-slide-target="0"
      aria-label="Show 1 product offer"
      aria-pressed="true">
    </button>

    <button
      type="button"
      data-slide-target="1"
      aria-label="Show 2 product offer"
      aria-pressed="false">
    </button>

    <button
      type="button"
      data-slide-target="2"
      aria-label="Show 3 product offer"
      aria-pressed="false">
    </button>

  </div>

</section>

<script>
(function () {
  const hero = document.getElementById('purelane-hero');
  if (!hero) return;

  const stage = hero.querySelector('#purelaneHeroStage');
  const slides = stage
    ? Array.from(stage.querySelectorAll('.purelane-hero-v2__slide'))
    : [];

  const controls = Array.from(
    hero.querySelectorAll('#purelaneHeroDots button')
  );

  const productArea = hero.querySelector('#heroProductArea');

  if (!stage || !slides.length || !controls.length) return;

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  let current = 0;
  let timer = null;

  function showSlide(index) {
    current = (index + slides.length) % slides.length;

    slides.forEach((slide, i) => {
      const active = i === current;
      slide.classList.toggle('is-active', active);
    });

    controls.forEach((control, i) => {
      const active = i === current;

      control.classList.toggle('is-active', active);
      control.setAttribute(
        'aria-pressed',
        active ? 'true' : 'false'
      );
    });
  }

  function startSlider() {
    if (reduceMotion || timer) return;

    timer = window.setInterval(function () {
      showSlide(current + 1);
    }, 4200);
  }

  function stopSlider() {
    if (!timer) return;

    window.clearInterval(timer);
    timer = null;
  }

  controls.forEach((control) => {
    control.addEventListener('click', function () {
      const target = Number(control.dataset.slideTarget);

      stopSlider();
      showSlide(target);

      /* Restart the 4.2s countdown after manual selection. */
      startSlider();
    });
  });

  /*
   * Pause only while the product stage is being inspected.
   * Moving away resumes the automatic 1 → 2 → 3 cycle.
   */
  if (productArea) {
    productArea.addEventListener('mouseenter', stopSlider);
    productArea.addEventListener('mouseleave', startSlider);
  }

  /*
   * Cursor parallax:
   * cursor LEFT  -> bottles move RIGHT
   * cursor RIGHT -> bottles move LEFT
   */
  if (
    !reduceMotion &&
    window.matchMedia('(min-width: 900px)').matches
  ) {
    hero.addEventListener('mousemove', function (event) {
      const rect = hero.getBoundingClientRect();

      const x =
        ((event.clientX - rect.left) / rect.width - 0.5) * 2;

      const y =
        ((event.clientY - rect.top) / rect.height - 0.5) * 2;

      stage.style.setProperty(
        '--mouse-x',
        `${x * -18}px`
      );

      stage.style.setProperty(
        '--mouse-y',
        `${y * -10}px`
      );

      hero.style.setProperty(
        '--wave-x',
        `${x * 12}px`
      );

      hero.style.setProperty(
        '--wave-y',
        `${y * 8}px`
      );
    });

    hero.addEventListener('mouseleave', function () {
      stage.style.setProperty('--mouse-x', '0px');
      stage.style.setProperty('--mouse-y', '0px');

      hero.style.setProperty('--wave-x', '0px');
      hero.style.setProperty('--wave-y', '0px');
    });
  }

  showSlide(0);
  startSlider();
})();
</script>

{% schema %}
{
  "name": "Purelane Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean That Lasts"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Homecare that works on the toughest grime, made from plants."
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero"
    }
  ]
}
{% endschema %}
