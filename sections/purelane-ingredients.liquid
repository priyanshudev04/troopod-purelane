{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section class="purelane-ingredients" id="ingredients">
  <div class="purelane-ingredients__container">

    <div class="purelane-ingredients__header">

      {% if section.settings.eyebrow != blank %}
        <span class="purelane-ingredients__eyebrow">
          {{ section.settings.eyebrow }}
        </span>
      {% endif %}

      <h2>{{ section.settings.heading }}</h2>

      {% if section.settings.description != blank %}
        <p>{{ section.settings.description }}</p>
      {% endif %}

    </div>

    {% if section.blocks.size > 0 %}

      <div class="purelane-ingredients__grid">

        {% for block in section.blocks %}

          <article
            class="purelane-ingredient"
            {{ block.shopify_attributes }}
          >

            <div class="purelane-ingredient__icon">

              {% if block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 240
                  | image_tag:
                    loading: 'lazy',
                    widths: '120,180,240',
                    sizes: '72px',
                    alt: block.settings.title
                }}

              {% else %}

                <span
                  class="purelane-ingredient__fallback"
                  aria-hidden="true"
                >
                  ✦
                </span>

              {% endif %}

            </div>

            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <p>{{ block.settings.description }}</p>
            {% endif %}

          </article>

        {% endfor %}

      </div>

    {% else %}

      <div class="purelane-ingredients__empty">
        <p>Add ingredients from the Theme Editor.</p>
      </div>

    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Purelane Ingredients",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHAT'S INSIDE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sourced from nature"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Plant-derived ingredients chosen to clean effectively without the harsh stuff."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ingredient image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Ingredient name",
          "default": "Coconut"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Plant-derived cleansers that lift grease"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Ingredients",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "title": "Coconut",
            "description": "Plant-derived cleansers that lift grease"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Orange peel",
            "description": "Natural degreaser and fresh citrus lift"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Soap nut",
            "description": "A traditional plant foaming agent"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Neem",
            "description": "Time-tested antibacterial from the tree"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Lemongrass",
            "description": "Clean fragrance with nothing synthetic"
          }
        }
      ]
    }
  ]
}
{% endschema %}
